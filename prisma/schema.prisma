generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum ContractStatus {
  DRAFT
  RUNNING
  EXPIRED
  CANCELLED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  DEDUCTION
  GROSS
  NET
}

enum AmountType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum LeaveAllocationStatus {
  DRAFT
  APPROVED
  REFUSED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  DEPT_MANAGER
  EMPLOYEE
  RECRUITER
  PAYROLL_MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  PROBATION
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  WORK_FROM_HOME
  HOLIDAY
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
  FAILED
}

enum CandidateStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  SELECTED
  REJECTED
  OFFERED
  HIRED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum DocumentType {
  IDENTITY
  CONTRACT
  POLICY
  CERTIFICATE
  OTHER
}

enum NotificationType {
  LEAVE_REQUEST
  PAYROLL_UPDATE
  SYSTEM_ALERT
  ANNOUNCEMENT
  PERFORMANCE_REVIEW
  RECRUITMENT
}

enum AIActionType {
  CHAT_QUERY
  RESUME_PARSING
  CANDIDATE_MATCH
  DOCUMENT_GENERATION
  POLICY_SEARCH
  ATTENDANCE_INSIGHT
  PAYSLIP_EXPLAIN
  LEAVE_ANOMALY
  EMPLOYEE_SUMMARY
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

// ------------------------------------------------------
// NEXTAUTH REQUIRED MODELS
// ------------------------------------------------------

model Account {
  id                String  @id @default(uuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(uuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// TENANT / COMPANY MANAGEMENT
// ------------------------------------------------------

model Company {
  id            String        @id @default(uuid()) @map("_id")
  name          String
  logoUrl       String?
  website       String?
  industry      String?
  employeeCount Int           @default(0)
  timezone      String        @default("UTC")
  currency      String        @default("USD")
  subscription  Subscription?
  isActive      Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[]
  departments      Department[]
  employees        Employee[]
  jobs             Job[]
  leaves           LeaveRequest[]
  leaveTypes       LeaveType[]
  payrolls         PayrollRun[]
  auditLogs        AuditLog[]
  policies         Policy[]
  notifications    Notification[]
  contracts        Contract[]
  workingSchedules WorkingSchedule[]
  salaryStructures SalaryStructure[]
}

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

model Subscription {
  id                   String    @id @default(uuid()) @map("_id")
  companyId            String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  planTier             PlanTier  @default(GROWTH) // Default to GROWTH for 14-day trial
  status               String    @default("trialing")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Department {
  id          String  @id @default(uuid()) @map("_id")
  companyId   String
  name        String
  description String?
  managerId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ------------------------------------------------------
// AUTHENTICATION & USERS
// ------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @map("_id")
  email         String    @unique
  emailVerified DateTime?
  password      String? // Added for Credentials auth
  image         String?
  companyId     String
  role          UserRole  @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee?

  accounts      Account[]
  sessions      Session[]
  notifications Notification[]

  @@index([companyId])
}

// ------------------------------------------------------
// EMPLOYEE MANAGEMENT
// ------------------------------------------------------

model Employee {
  id           String  @id @default(uuid()) @map("_id")
  companyId    String
  userId       String  @unique
  departmentId String?
  managerId    String? // Direct manager for leave approval chain

  employeeCode String
  firstName    String
  lastName     String
  designation  String?
  joiningDate  DateTime
  status       EmployeeStatus @default(ACTIVE)

  workEmail     String
  personalEmail String?
  phone         String?

  // Salary configuration — null means "not yet set / to be backfilled"
  baseSalary       Float? // Monthly gross base salary (e.g. 50000.00)
  allowancePercent Float? // Allowances as % of baseSalary (default: 20%)
  deductionPercent Float? // Deductions as % of baseSalary (default: 12%)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  workingScheduleId String?
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])

  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  leaveAllocations LeaveAllocation[]
  payslips         Payslip[]
  documents        Document[]
  goals            Goal[]
  contracts        Contract[]

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
  @@index([departmentId])
}

// ------------------------------------------------------
// ATTENDANCE MANAGEMENT
// ------------------------------------------------------

model Attendance {
  id           String           @id @default(uuid()) @map("_id")
  employeeId   String
  date         DateTime
  checkInTime  DateTime?
  checkOutTime DateTime?
  status       AttendanceStatus
  totalHours   Float?
  ipAddress    String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, status])
  @@index([date])
}

// ------------------------------------------------------
// LEAVE MANAGEMENT
// ------------------------------------------------------

model LeaveRequest {
  id          String     @id @default(uuid()) @map("_id")
  companyId   String
  employeeId  String
  leaveTypeId String?
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  startDate    DateTime
  endDate      DateTime
  totalDays    Float
  reason       String
  status       LeaveStatus           @default(PENDING)
  approvedById String? // Manager who approved
  approvedByHrId String? // HR who gave final approval
  managerApprovalStatus LeaveApprovalStatus @default(PENDING)
  hrApprovalStatus      LeaveApprovalStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
}

// ------------------------------------------------------
// PAYROLL MANAGEMENT
// ------------------------------------------------------

model LeaveType {
  id                  String  @id @default(uuid()) @map("_id")
  companyId           String
  name                String // e.g. "Casual Leave", "Sick Leave"
  annualQuota         Int
  carryForwardAllowed Boolean @default(false)
  isPaid              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  allocations   LeaveAllocation[]

  @@index([companyId])
}

model PayrollRun {
  id                String           @id @default(uuid()) @map("_id")
  companyId         String
  month             Int
  year              Int
  periodStart       DateTime
  periodEnd         DateTime
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  status            PayrollStatus    @default(DRAFT)
  totalAmount       Float
  processedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([companyId, month, year])
  @@index([companyId, status])
}

model Payslip {
  id               String           @id @default(uuid()) @map("_id")
  payrollRunId     String
  employeeId       String
  workedDays       Float            @default(0)
  totalWorkingDays Float            @default(0)
  contractId       String?
  contract         Contract?        @relation(fields: [contractId], references: [id])
  structureId      String?
  structure        SalaryStructure? @relation(fields: [structureId], references: [id])
  basicSalary      Float
  allowances       Float
  deductions       Float
  netSalary        Float
  lines            PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

// ------------------------------------------------------
// RECRUITMENT MANAGEMENT
// ------------------------------------------------------

model Job {
  id           String  @id @default(uuid()) @map("_id")
  companyId    String
  title        String
  department   String
  location     String
  type         String
  description  String
  requirements String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@index([companyId, isActive])
}

model Candidate {
  id           String          @id @default(uuid()) @map("_id")
  jobId        String
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumeUrl    String?
  status       CandidateStatus @default(APPLIED)
  aiMatchScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
}

// ------------------------------------------------------
// DOCUMENT MANAGEMENT
// ------------------------------------------------------

model Document {
  id         String       @id @default(uuid()) @map("_id")
  employeeId String
  title      String
  type       DocumentType
  fileUrl    String
  isVerified Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ------------------------------------------------------
// AUDIT LOGS
// ------------------------------------------------------

model AuditLog {
  id        String  @id @default(uuid()) @map("_id")
  companyId String
  userId    String?
  module    String
  action    String
  recordId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, module])
  @@index([companyId, createdAt])
}

// ------------------------------------------------------
// AI ASSISTANT
// ------------------------------------------------------

model AILog {
  id         String       @id @default(uuid()) @map("_id")
  companyId  String
  userId     String
  actionType AIActionType
  prompt     String
  response   String
  tokensUsed Int          @default(0)

  createdAt DateTime @default(now())

  @@index([companyId, actionType])
}

// ------------------------------------------------------
// PERFORMANCE MANAGEMENT
// ------------------------------------------------------

model Goal {
  id          String     @id @default(uuid()) @map("_id")
  employeeId  String
  title       String
  description String
  status      GoalStatus @default(NOT_STARTED)
  progress    Int        @default(0) // 0-100
  dueDate     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ------------------------------------------------------
// POLICY MANAGEMENT
// ------------------------------------------------------

model Policy {
  id            String   @id @default(uuid()) @map("_id")
  companyId     String
  title         String
  description   String
  category      String   @default("General")
  fileUrl       String?
  effectiveDate DateTime
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
}

model Notification {
  id        String  @id @default(uuid()) @map("_id")
  companyId String
  userId    String
  title     String
  message   String
  type      String // 'LEAVE', 'PAYROLL', 'SYSTEM', etc.
  isRead    Boolean @default(false)
  link      String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([companyId])
}

// ------------------------------------------------------
// HR & PAYROLL - NEW MODELS
// ------------------------------------------------------

model Contract {
  id                String         @id @default(uuid()) @map("_id")
  companyId         String
  employeeId        String
  startDate         DateTime
  endDate           DateTime?
  wage              Float
  departmentId      String?
  jobPosition       String?
  salaryStructureId String?
  status            ContractStatus @default(DRAFT)
  isActive          Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  payslips        Payslip[]

  @@index([companyId])
  @@index([employeeId])
}

model WorkingSchedule {
  id          String @id @default(uuid()) @map("_id")
  companyId   String
  name        String
  type        String
  weeklyHours Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines     WorkingScheduleLine[]
  employees Employee[]

  @@index([companyId])
}

model WorkingScheduleLine {
  id           String @id @default(uuid()) @map("_id")
  scheduleId   String
  dayOfWeek    Int // 0-6
  startTime    String // e.g., "09:00"
  endTime      String // e.g., "17:00"
  breakMinutes Int?

  schedule WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model SalaryStructure {
  id        String  @id @default(uuid()) @map("_id")
  companyId String
  name      String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rules       SalaryRule[]
  contracts   Contract[]
  payrollRuns PayrollRun[]
  payslips    Payslip[]

  @@index([companyId])
}

model SalaryRule {
  id               String             @id @default(uuid()) @map("_id")
  structureId      String
  name             String
  code             String
  category         SalaryRuleCategory
  sequence         Int
  amountType       AmountType
  amount           Float?
  percentage       Float?
  formula          String?
  appearsOnPayslip Boolean            @default(true)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

model LeaveAllocation {
  id            String                @id @default(uuid()) @map("_id")
  employeeId    String
  leaveTypeId   String
  numberOfDays  Float
  takenDays     Float                 @default(0)
  remainingDays Float
  dateFrom      DateTime
  dateTo        DateTime
  status        LeaveAllocationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
}

model PayslipLine {
  id        String @id @default(uuid()) @map("_id")
  payslipId String
  code      String
  name      String
  category  String
  amount    Float
  sequence  Int

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}
